# Copy to .env.local for local development (.env* is gitignored).
# In production these come from the k8s deployment env + the
# veranacouncil-website-secrets Secret — do NOT ship a .env file.

# Relaticle CRM — the contact form posts inquiries here.
# Locally you can point at the public instance; in-cluster the deployment uses
# http://relaticle.relaticle.svc.cluster.local
RELATICLE_API_URL=https://crm.2060.io
RELATICLE_API_TOKEN=

# Optional: Discord/Slack-compatible webhook for best-effort ops alerts when a
# CRM write fails. Leave empty to log to stderr only.
ALERT_WEBHOOK_URL=

# ─── Membership / accounts ───────────────────────────────────────────────────
# In production ALL of these come from GitHub Actions secrets, injected by CI
# into the veranacouncil-website-secrets Secret (see docker-publish.yml).
# Never commit real values — this file holds placeholder keys only.

# Postgres. Local dev points at the docker/ compose Postgres (npm run db:up).
# In production CI derives this from POSTGRES_PASSWORD (host/user/db are fixed
# in k8s), so DATABASE_URL is NOT a separate prod secret.
DATABASE_URL=postgresql://verana:verana@localhost:5432/verana?schema=public

# Auth.js (NextAuth v5). AUTH_SECRET: generate with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# OAuth providers (verified-email sign-in). Create apps in Google / GitHub —
# the Council site needs ITS OWN OAuth clients for the veranacouncil.org domain.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Transactional email over SMTP (magic links, executed-agreement copy, ballot
# notifications). Gmail/Workspace needs an App Password — enable 2FA on the
# account, then create one at https://myaccount.google.com/apppasswords (the
# raw account password won't work). MAIL_PORT 587 = STARTTLS, 465 = SSL (or set
# MAIL_ENCRYPTION=ssl).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@veranacouncil.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@veranacouncil.org
MAIL_FROM_NAME=Verana Council
# Optional: absolute URL of a hosted raster (PNG) Verana logo for email headers.
# Unset → a styled text wordmark is used (SVG/remote images render unreliably in
# many email clients, so prefer a small PNG if you set this).
EMAIL_LOGO_URL=

# ─── Admission ballots (provisional, pre-mainnet) ────────────────────────────
# Async ballot window in days (default 14). CRON_SECRET guards
# /api/cron/ballots, which closes ballots whose window has ended — hit it daily
# from an external scheduler.
BALLOT_WINDOW_DAYS=14
CRON_SECRET=

# Filesystem storage for member-generated files (signed candidate-agreement
# PDFs, org logos). In production this is a mounted PVC at /data; locally it
# defaults to ./var/storage when unset.
STORAGE_DIR=

# Bootstrap admin emails (comma-separated) seeded into the admin allowlist on
# first run. After bootstrap, admins are managed in /admin/admins.
ADMIN_BOOTSTRAP_EMAILS=

# Optional: which legal/ version file the seed activates as the Candidate
# Agreement (admins can switch versions in /admin/settings). Defaults to
# candidate-agreement-v1.md — a clearly-marked DRAFT placeholder until the
# reviewed agreement lands.
AGREEMENT_FILENAME=candidate-agreement-v1.md

# ── Council bodies & committees (meetings machinery) ─────────────────────────
# Google Calendar sync: a service account with domain-wide delegation
# (scope https://www.googleapis.com/auth/calendar.events) impersonates the
# meetings role account, which organizes every meeting (auto Meet links,
# native invitations). Schedules still save without this; sync is retried.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_IMPERSONATE=meetings@verana.io

# Public minutes repository: published session notes are committed to
# <body-slug>/minutes/YYYY-MM-DD.md. Fine-grained PAT, Contents read/write on
# this single repo.
MINUTES_REPO=verana-labs/verana-council-gov
MINUTES_GITHUB_TOKEN=

# Optional: raises the GitHub API rate limit. When unset, MINUTES_GITHUB_TOKEN
# is used as fallback.
GITHUB_TOKEN=
